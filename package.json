{
  "name": "bhutan-eccd-pulse",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node scripts/build-server.mjs && vite build",
    "start": "node server.mjs",
    "build:server": "node scripts/build-server.mjs",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "lint": "oxlint",
    "preview": "vite preview",
    "prisma:generate": "prisma generate --schema backend/prisma/schema.prisma",
    "prisma:push": "prisma db push --schema backend/prisma/schema.prisma",
    "prisma:seed": "node backend/prisma/seed.mjs",
    "prisma:migrate": "prisma db push --schema backend/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.544.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.5.2",
    "esbuild": "^0.25.12",
    "oxlint": "^1.89.0",
    "prisma": "5.22.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^6.3.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
